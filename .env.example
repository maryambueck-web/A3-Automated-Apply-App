APP_NAME=LinkedIn Automated Apply App
APP_API_KEY=replace-with-long-random-string
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/linkedin_apply
KEY_VAULT_URL=https://your-key-vault-name.vault.azure.net/
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_EMAIL_SECRET_NAME=linkedin-email
LINKEDIN_PASSWORD_SECRET_NAME=linkedin-password
LINKEDIN_DEFAULT_KEYWORDS=software engineer,backend engineer
LINKEDIN_DEFAULT_LOCATION=Germany
LINKEDIN_EASY_APPLY_ONLY=true
LINKEDIN_HEADLESS=true
LINKEDIN_MAX_JOBS_PER_RUN=20
LINKEDIN_SCHEDULE_CRON=0 8 * * *
LINKEDIN_DAILY_LIMIT=20
CORS_ORIGINS=http://localhost:5173
